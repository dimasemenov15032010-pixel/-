# Скопируй этот файл в .env и заполни своими значениями.
# Файл .env НЕ должен попадать в git / публичные репозитории.

# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=

# Ключ шифрования паролей. Сгенерируй один раз командой:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# И больше НЕ МЕНЯЙ его — если ключ поменяется или потеряется,
# все ранее сохранённые пароли расшифровать будет невозможно.
ENCRYPTION_KEY=

# ID Telegram-группы, в которой ТОЛЬКО и будут работать команды бота.
# Как узнать: добавь бота @userinfobot в свою группу — он покажет ID чата
# (для групп это отрицательное число вида -1001234567890).
# Вне этой группы бот не будет отвечать вообще ни на что.
ADMIN_GROUP_ID=
